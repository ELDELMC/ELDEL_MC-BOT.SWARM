# JUANCHOTE-SWARM — Example environment variables (no secrets)
# Copy this file to `.env` and fill real values locally (do NOT commit `.env`).

# Bot identity
BOT_NAME=⸙𝙴𝙻𝙳𝙴𝙻_𝙼𝙲-𝙱𝙾𝚃⸙
OWNER_NUMBER=573xxxxxxxxx
AUTHOR=ELDEL_MC

# Sessions config
SESSION_COUNT=2
BOT_ROTO=573xxxxxxxxx
PERSONAL=573xxxxxxxxx

# Command config
PREFIXES=.,!,/,#
COMMAND_MODE=public

# Server
PORT=3003
TIMEZONE=America/Bogota

# Performance tuning
DEDUP_TTL=60
ADMIN_CACHE_TTL=300
DATA_CACHE_MS=5000
WARN_COUNT=3

# ESTABILIDAD 24/7
KEEPALIVE_MS=60000
WATCHDOG_TIMEOUT_MS=180000
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_DELAY_MS=15000

# MongoDB Cloud Connection (set locally if used)
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/juanchote?retryWrites=true&w=majority
